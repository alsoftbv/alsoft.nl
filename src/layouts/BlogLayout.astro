---
import BaseLayout from "./BaseLayout.astro";
const { data, slug } = Astro.props;

const url = Astro.url.origin;
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={`${url}/og/${slug}.png`}
  type="article"
>
  <div class="post-content">
    <h1 class="title">{data.title}</h1>
    <p class="date">
      {
        data.date
          .toLocaleDateString("en-GB", {
            day: "2-digit",
            month: "2-digit",
            year: "numeric",
          })
          .replace(/\//g, "-")
      }
    </p>
    <slot />
  </div>
</BaseLayout>

<style is:inline>
  .post-content {
    max-width: 760px;
    margin: 3rem auto;
    padding: 0 1.5rem;
  }

  .post-content h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
  }

  .post-content h1,
  .post-content h2 {
    font-weight: 700;
    margin: 1.2rem 0 1rem 0;
  }

  .post-content h3 {
    font-weight: 600;
    margin: 1rem 0;
  }

  .post-content img {
    width: 60%;
    height: auto;
    margin: 2rem 20% 0 20%;
  }

  .post-content blockquote {
    text-align: center;
    font-style: italic;
    margin: 0 0 2rem 0;
  }

  .post-content hr {
    width: 240px;
    margin: 2rem auto;
    border: none;
    height: 2px;
    background-color: var(--border);
    opacity: 1;
  }

  .post-content p {
    margin: 0 0 1rem 0;
    line-height: 1.75;
  }

  .post-content ul {
    margin: 0.8rem 0;
  }

  .post-content li {
    line-height: 2;
  }

  .post-content code {
    background: var(--surface-2);
    border-radius: 4px;
    padding: 0.2rem 0.5rem;
    font-size: 0.9em;
  }

  .post-content pre.astro-code {
    background-color: var(--surface) !important;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin: 1rem 0;
  }

  .post-content pre code {
    background: none;
    padding: 0;
    border-radius: 0;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .post-content .date {
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .post-content .title {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .post-content {
      margin: 2rem auto;
      padding: 0 0.8rem;
    }

    .post-content img {
      width: 100%;
      margin: 1rem 0 0 0;
    }

    .post-content blockquote {
      margin-bottom: 1rem;
    }
  }
</style>
