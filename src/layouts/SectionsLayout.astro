---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import Button from "@components/Button.astro";
import type { CardItem } from "@data/card-item";
import en from "@locales/en.json";
import nl from "@locales/nl.json";
import Card from "@components/Card.astro";

interface Props {
  pageTitle: string;
  data: CardItem[];
  title: string;
  description: string;
}

const { pageTitle, data, title, description }: Props = Astro.props;
const t = Astro.currentLocale === "nl" ? nl : en;
---

<BaseLayout title={title} description={description}>
  <Header>{pageTitle}</Header>
  <section class="content-section">
    {
      data.map((item: CardItem, index: number) => {
        const translated = t.cards[item.id as keyof typeof t.cards];
        const details =
          "points" in translated
            ? {
                points: translated.points,
                proof: "proof" in translated ? translated.proof : undefined,
              }
            : undefined;

        return (
          <Card
            class={`content-wrapper ${index % 2 !== 0 ? "reverse" : ""}`}
            id={item.id}
          >
            {item.image && (
              <div class="image-wrapper">
                <Image
                  class="content-image"
                  src={item.image}
                  alt=""
                  width={720}
                  decoding="async"
                  loading={index === 0 ? "eager" : "lazy"}
                />
              </div>
            )}
            {details && (
              <div class="details">
                <ul>
                  {details.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
                {details.proof && (
                  <p class="proof">
                    <span class="eyebrow">{t.proofLabel}</span>
                    {details.proof}
                  </p>
                )}
              </div>
            )}
            <div class="text-content">
              {item.icon && (
                <Image src={item.icon} alt="" width={32} height={32} />
              )}
              <h2>{translated.title}</h2>
              <p class="lead">{translated.description}</p>
              <p class="content-description">{translated.longDescription}</p>
              <Button
                href={getRelativeLocaleUrl(
                  Astro.currentLocale ?? "en",
                  "/contact"
                )}
                class="get-in-touch"
              >
                {t.getInTouch}
              </Button>
              {item.page && (
                <a
                  class="learn-more"
                  href={getRelativeLocaleUrl(
                    Astro.currentLocale ?? "en",
                    item.page
                  )}
                >
                  {t.hardware.learnMore} →
                </a>
              )}
            </div>
          </Card>
        );
      })
    }
  </section>
</BaseLayout>

<style>
  .content-section {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem 5rem;
    margin: 0 auto;
    max-width: var(--container);
  }

  .content-wrapper {
    display: flex;
    align-items: center;
    width: 100%;
    gap: 3rem;
    scroll-margin-top: 5rem;
  }

  .reverse {
    flex-direction: row-reverse;
  }

  .image-wrapper {
    width: 45%;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
  }

  .image-wrapper img {
    width: 100%;
    height: auto;
    display: block;
  }

  .details {
    width: 42%;
    flex-shrink: 0;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
    padding: 1.75rem;
    box-sizing: border-box;
    background: var(--surface-2);
    border-radius: 8px;
  }

  .details ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .details li {
    position: relative;
    padding-left: 1.75rem;
    line-height: 1.5;
  }

  .details li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }

  .proof {
    margin: 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
  }

  .proof .eyebrow {
    margin-bottom: 0.4rem;
  }

  .text-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
  }

  .text-content p {
    margin: 0;
  }

  .text-content h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .lead {
    color: var(--accent);
    font-weight: 500;
  }

  .content-description {
    color: var(--muted);
  }

  .get-in-touch {
    width: fit-content;
    margin-top: 0.5rem;
  }

  .learn-more {
    width: fit-content;
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }

  .learn-more:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .content-section {
      padding: 1.5rem 1rem 3rem;
    }

    .content-wrapper {
      flex-direction: column;
      gap: 1rem;
      padding: 1rem;
    }

    .image-wrapper,
    .details {
      width: 100%;
    }

    .details {
      order: 1;
      padding: 1.25rem;
    }
  }
</style>
