---
import Button from "./Button.astro";
import { Image } from "astro:assets";

import logoImage from "@images/logo.png";

import en from "@locales/en.json";
import nl from "@locales/nl.json";
import Card from "./Card.astro";

const locale = Astro.currentLocale ?? "en";
const t = locale === "nl" ? nl : en;
const contactText =
  locale === "nl" ? "Contactformulier" : "Contact Form Submission";
---

<section class="contact-section">
  <Card class="content">
    <form class="contact-form" id="contact-form">
      <label for="contact-name">{t.contact.yourName}</label>
      <input id="contact-name" name="name" type="text" autocomplete="name" />
      <label for="contact-message">{t.contact.tellUs}</label>
      <textarea id="contact-message" name="message" required></textarea>
      <Button type="submit" class="submit">{t.contact.submit}</Button>
      <p class="note">
        {t.contact.mailNote}
        {t.contact.orEmail}
        <a href="mailto:info@alsoft.nl">info@alsoft.nl</a>
      </p>
    </form>
    <div class="contact-image">
      <Image src={logoImage} alt="" loading="eager" />
    </div>
  </Card>
</section>

<style>
  .contact-section {
    padding: 3rem 1.5rem;
  }

  .content {
    padding: 2.5rem;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    max-width: var(--container);
    margin: 0 auto;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .contact-form label {
    font-weight: 600;
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    box-sizing: border-box;
    margin-bottom: 1.5rem;
  }

  .contact-form textarea {
    min-height: 10rem;
  }

  .submit {
    align-self: flex-start;
  }

  .contact-image {
    max-width: 20%;
  }

  .contact-image img {
    width: 100%;
    height: auto;
  }

  .note {
    margin: 1.25rem 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .note a {
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .content {
      padding: 1.25rem;
    }

    .contact-section {
      padding: 1.5rem 1rem;
    }

    .contact-image {
      display: none;
    }

    .contact-form textarea {
      min-height: 12rem;
    }
  }
</style>

<script is:inline define:vars={{ contactText }}>
  document.getElementById("contact-form")?.addEventListener("submit", (e) => {
    e.preventDefault();

    const form = e.currentTarget;
    const name = form.elements.name.value.trim();
    const message = form.elements.message.value;

    const subject = encodeURIComponent(
      name ? `${contactText} - ${name}` : contactText
    );
    const body = encodeURIComponent(message);

    window.location.href = `mailto:info@alsoft.nl?subject=${subject}&body=${body}`;
  });
</script>
