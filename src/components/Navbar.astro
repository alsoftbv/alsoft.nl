---
import Button from "@components/Button.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
import logoImage from "@images/logo.png";
import en from "@locales/en.json";
import nl from "@locales/nl.json";
import enFlag from "@images/nav/en.svg";
import nlFlag from "@images/nav/nl.svg";

const locale = Astro.currentLocale ?? "en";

const enPath = Astro.url.pathname.replace(/^\/nl(\/|$)/, "/");
const targetLocale = locale === "nl" ? "en" : "nl";
const targetPath = locale === "nl" ? enPath : `/nl${enPath}`;
const languageLabel =
  targetLocale === "nl" ? "Bekijk in het Nederlands" : "View in English";

const flag = locale === "nl" ? enFlag : nlFlag;
const t = locale === "nl" ? nl : en;

const links = [
  { name: t.services.header, href: "/services" },
  { name: t.industries.header, href: "/industries" },
  { name: t.blog.header, href: "/blog" },
  { name: t.tools.header, href: "/tools" },
];
---

<nav class="navbar">
  <div class="content">
    <div class="logo">
      <a href={getRelativeLocaleUrl(locale)}
        ><Image src={logoImage} alt="alsoft home" loading="eager" /></a
      >
    </div>
    <ul class="nav-links" id="nav-links">
      {
        links.map((link) => (
          <li>
            <a href={getRelativeLocaleUrl(locale, link.href)}>{link.name}</a>
          </li>
        ))
      }
      <li>
        <a
          href={targetPath}
          hreflang={targetLocale}
          aria-label={languageLabel}
          class="mobile-flag"
          ><Image
            class="change-language"
            src={flag}
            alt=""
            loading="eager"
          /></a
        >
      </li>
      <li class="mobile-contact">
        <Button href={getRelativeLocaleUrl(locale, "/contact")}
          >{t.getInTouch}</Button
        >
      </li>
    </ul>
    <button
      type="button"
      class="menu-toggle"
      id="menu-toggle"
      aria-label="Menu"
      aria-controls="nav-links"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
    <a
          href={targetPath}
          hreflang={targetLocale}
          aria-label={languageLabel}
          class="desktop-flag"
          ><Image
        class="change-language"
        src={flag}
        alt=""
        loading="eager"
      /></a
    >
    <Button
      href={getRelativeLocaleUrl(locale, "/contact")}
      class="desktop-contact">{t.getInTouch}</Button
    >
  </div>
</nav>

<script>
  const toggle = document.getElementById("menu-toggle");
  const navLinks = document.getElementById("nav-links");

  if (toggle && navLinks) {
    const setOpen = (open: boolean) => {
      navLinks.classList.toggle("show", open);
      navLinks.classList.toggle("active", open);
      toggle.classList.toggle("active", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(!toggle.classList.contains("active"));
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        setOpen(false);
      }
    });

    document.addEventListener("click", (e) => {
      if (!(e.target instanceof Node)) {
        return;
      }

      if (!toggle.contains(e.target) && !navLinks.contains(e.target)) {
        setOpen(false);
      }
    });
  }
</script>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(13, 14, 16, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 1.5rem;
    max-width: var(--container);
    margin: 0 auto;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 45px;
    height: 45px;
    padding: 0;
    background: none;
    cursor: pointer;
  }

  .menu-toggle:hover {
    background: none;
    transform: none;
  }

  .menu-toggle span {
    display: block;
    width: 30px;
    height: 3px;
    background-color: var(--text);
    margin: 4px 0;
    border-radius: 8px;
    transition:
      transform 0.3s,
      opacity 0.3s;
    transform-origin: center;
  }

  .menu-toggle.active span:nth-child(1) {
    transform: translateY(11px) rotate(45deg);
  }

  .menu-toggle.active span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle.active span:nth-child(3) {
    transform: translateY(-11px) rotate(-45deg);
  }

  .nav-links {
    list-style: none;
    display: flex;
    gap: 2rem;
    margin: 0;
    margin-left: 2rem;
    padding: 0;
    flex-grow: 1;
    transition: max-height 0.3s ease;
    border-radius: 8px;
  }

  .nav-links a:not(.btn) {
    text-decoration: none;
    font-size: 0.95rem;
    color: var(--muted);
    transition: color 0.2s ease;
  }

  .nav-links a:not(.btn):hover {
    color: var(--text);
  }

  .change-language {
    height: 1.5rem;
    width: auto;
  }

  .mobile-flag {
    display: none;
  }

  .desktop-flag {
    display: block;
    margin-right: 2em;
  }

  .mobile-contact {
    display: none;
  }

  .desktop-contact {
    display: block;
  }

  @media (max-width: 768px) {
    .nav-links {
      margin: 0;
      position: absolute;
      top: 4rem;
      right: 1rem;
      background: var(--surface);
      border: 1px solid var(--border);
      flex-direction: column;
      gap: 1.5rem;
      align-items: end;
      max-height: 0;
      overflow: hidden;
      visibility: hidden;
      opacity: 0;
      transition:
        max-height 0.7s ease,
        opacity 0.3s ease,
        visibility 0.3s ease;
      display: none;
    }

    .nav-links.show {
      visibility: visible;
      opacity: 1;
      display: flex;
      padding: 2rem;
    }

    .nav-links.active {
      max-height: 500px;
    }

    .menu-toggle {
      display: flex;
    }

    .mobile-flag {
      display: block;
    }

    .desktop-flag {
      display: none;
    }

    .mobile-contact {
      display: block;
    }
    .desktop-contact {
      display: none;
    }
  }

  .logo img {
    height: 2.5rem;
    padding: 0.5rem 0;
    width: auto;
    display: block;
  }
</style>
