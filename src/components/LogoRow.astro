---
import { Image } from "astro:assets";

export interface Logo {
  src: ImageMetadata;
  href: string;
  name: string;
}

interface Props {
  logos: Logo[];
}

const { logos } = Astro.props as Props;
---

<ul class="logo-row">
  {
    logos.map((logo) => (
      <li>
        <a href={logo.href} target="_blank" rel="noopener">
          <Image src={logo.src} alt={logo.name} height={96} loading="lazy" />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .logo-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem 3rem;
  }

  .logo-row a {
    display: block;
  }

  .logo-row img {
    display: block;
    height: 2.5rem;
    width: auto;
    max-width: 160px;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.55;
    transition: opacity 0.2s ease;
  }

  .logo-row a:hover img,
  .logo-row a:focus-visible img {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .logo-row {
      justify-content: center;
    }

    .logo-row img {
      height: 2rem;
    }
  }
</style>
