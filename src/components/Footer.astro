---
import Button from "./Button.astro";
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";

import logoImage from "@images/logo.png";
import linkedinImage from "@images/footer/linkedin.png";
import githubImage from "@images/footer/github.png";
import locationImage from "@images/footer/location.svg";
import mailImage from "@images/footer/mail.svg";

import en from "@locales/en.json";
import nl from "@locales/nl.json";

const locale = Astro.currentLocale ?? "en";
const t = Astro.currentLocale === "nl" ? nl : en;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="content">
    <div class="footer-left">
      <Image class="logo" src={logoImage} alt="alsoft" loading="lazy" />
      <p class="tagline">{t.indexHeader}</p>
      <div class="icon-text">
        <Image src={mailImage} alt="" loading="lazy" />
        <a href="mailto:info@alsoft.nl?subject=Get%20In%20Touch"
          >info@alsoft.nl</a
        >
      </div>
      <div class="icon-text">
        <Image src={locationImage} alt="" loading="lazy" />
        <p>{t.address}</p>
      </div>
      <div class="links">
        <a
          class="icon-text"
          href="https://www.linkedin.com/company/alsoftbv"
          target="_blank"
          rel="noopener"
        >
          <Image src={linkedinImage} alt="" loading="lazy" />LinkedIn
        </a>
        <a
          class="icon-text"
          href="https://github.com/alsoftbv"
          target="_blank"
          rel="noopener"
        >
          <Image src={githubImage} alt="" loading="lazy" />GitHub
        </a>
      </div>
    </div>

    <nav class="footer-right" aria-label="Footer">
      <a href={getRelativeLocaleUrl(locale, "/services")}>{t.services.header}</a
      >
      <a href={getRelativeLocaleUrl(locale, "/industries")}
        >{t.industries.header}</a
      >
      <a href={getRelativeLocaleUrl(locale, "/blog")}>{t.blog.header}</a>
      <a href={getRelativeLocaleUrl(locale, "/tools")}>{t.tools.header}</a>
      <Button href={getRelativeLocaleUrl(locale, "/contact")} class="contact"
        >{t.getInTouch}</Button
      >
    </nav>
  </div>

  <div class="legal">
    <p>© {year} alsoft · KvK 96553863 · BTW NL867658472B01</p>
  </div>
</footer>

<style>
  p,
  a {
    margin: 0;
    line-height: 1.4;
  }

  a:not(.btn) {
    text-decoration: none;
    color: var(--muted);
    transition: color 0.2s ease;
  }

  a:not(.btn):hover {
    color: var(--text);
  }

  img {
    height: 1.1rem;
    width: auto;
    display: block;
    margin: 0;
    border-radius: 10%;
  }

  .footer {
    background-color: var(--bg);
    border-top: 1px solid var(--border);
  }

  .content {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    gap: 2rem;
    padding: 3rem 1.5rem 2rem;
    max-width: var(--container);
    margin: 0 auto;
  }

  .footer-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .footer-left .logo {
    height: 2.5rem;
    border-radius: 0;
  }

  .tagline {
    color: var(--muted);
    margin-bottom: 0.5rem;
  }

  .footer-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
  }

  .contact {
    margin-top: 0.5rem;
    font-size: 0.9rem;
  }

  .links {
    display: flex;
    flex-direction: row;
    gap: 1.25rem;
  }

  .icon-text {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.5em;
    color: var(--muted);
  }

  .legal {
    max-width: var(--container);
    margin: 0 auto;
    padding: 1.25rem 1.5rem 2rem;
    border-top: 1px solid var(--border);
  }

  .legal p {
    color: var(--muted);
    font-size: 0.8rem;
  }

  @media (max-width: 768px) {
    .content {
      flex-direction: column;
    }

    .footer-right {
      align-items: flex-start;
    }
  }
</style>
