---
import { Image } from "astro:assets";
import type { CardItem } from "@data/card-item";
import en from "@locales/en.json";
import nl from "@locales/nl.json";

interface Props {
  title: string;
  eyebrow?: string;
  intro?: string;
  page: string;
  items: CardItem[];
  contactTile?: string;
  columns?: 3 | 4;
}

const {
  title,
  eyebrow,
  intro,
  page,
  items,
  contactTile,
  columns = 4,
} = Astro.props as Props;
const t = Astro.currentLocale === "nl" ? nl : en;
---

<div class="cards-section">
  <div class="cards-heading">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h2>{title}</h2>
    {intro && <p class="muted">{intro}</p>}
  </div>
  <div class={`card-grid cols-${columns}`}>
    {
      items.map((item: CardItem) => {
        const translated = t.cards[item.id as keyof typeof t.cards];

        return (
          <a class="card-item" href={`${page}#${item.id}`}>
            {item.image && (
              <Image src={item.image} alt="" width={480} loading="lazy" />
            )}
            <div class="card-body">
              {item.icon && (
                <Image
                  class="icon"
                  src={item.icon}
                  alt=""
                  width={32}
                  height={32}
                />
              )}
              <h3>{translated.title}</h3>
              <p>{translated.description}</p>
              <span class="more" aria-hidden="true">
                →
              </span>
            </div>
          </a>
        );
      })
    }
    {
      contactTile && (
        <a class="card-item contact-tile" href={contactTile}>
          <div class="card-body">
            <h3>{t.notSure.title}</h3>
            <p>{t.notSure.description}</p>
            <span class="more" aria-hidden="true">
              {t.getInTouch} →
            </span>
          </div>
        </a>
      )
    }
  </div>
</div>

<style>
  .cards-heading {
    max-width: 640px;
    margin-bottom: 2rem;
  }

  .cards-heading h2 {
    margin-bottom: 0.75rem;
  }

  .cards-heading p {
    margin: 0;
  }

  .card-grid {
    display: grid;
    gap: 1.25rem;
  }

  .cols-4 {
    grid-template-columns: repeat(4, 1fr);
  }

  .cols-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 900px) {
    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .card-grid {
      grid-template-columns: 1fr;
    }
  }

  .card-item {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .card-item:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
  }

  .card-item img:not(.icon) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    flex: 1;
  }

  .icon {
    margin-bottom: 0.5rem;
  }

  .contact-tile {
    border-style: dashed;
    background: transparent;
  }

  .card-body h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .card-body p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .more {
    margin-top: auto;
    padding-top: 0.5rem;
    color: var(--accent);
    font-weight: 600;
    transition: transform 0.2s ease;
  }

  .card-item:hover .more {
    transform: translateX(4px);
  }
</style>
