---
import Header from "@components/Header.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

import {
  getLocalizedTools,
  getTranslationPaths,
  useTranslations,
} from "@locales/utils";

export function getStaticPaths() {
  return getTranslationPaths();
}

const t = useTranslations(Astro.params.lang);
const toolList = getLocalizedTools(Astro.params.lang);

const openSource = [
  { ...t.toolsOpenSource.tftpd, href: "https://github.com/altugbakan/rs-tftpd" },
  {
    ...t.toolsOpenSource.topicLab,
    href: "https://github.com/alsoftbv/topic-lab",
  },
];
---

<BaseLayout title={t.tools.title} description={t.tools.description}>
  <Header>{t.tools.header}</Header>
  <section class="tools">
    <div class="grid">
      {
        toolList.map(({ path, tool }) => (
          <a class="tool" href={path}>
            <h2>{tool.title}</h2>
            <p>{tool.description}</p>
            <span class="more" aria-hidden="true">
              →
            </span>
          </a>
        ))
      }
    </div>

    <div class="open-source">
      <h2>{t.toolsOpenSource.header}</h2>
      <p class="muted">{t.toolsOpenSource.intro}</p>
      <div class="grid">
        {
          openSource.map((project) => (
            <a class="tool" href={project.href} target="_blank" rel="noopener">
              <h2>{project.title}</h2>
              <p>{project.description}</p>
              <span class="more" aria-hidden="true">
                GitHub →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .tools {
    max-width: var(--container);
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .tool {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .tool:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
  }

  .tool h2 {
    margin: 0;
    font-size: 1.3rem;
  }

  .tool p {
    margin: 0;
    color: var(--muted);
  }

  .more {
    margin-top: auto;
    padding-top: 0.5rem;
    color: var(--accent);
    font-weight: 600;
  }

  .open-source {
    margin-top: 4rem;
  }

  .open-source > h2 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .open-source > p {
    margin: 0 0 1.5rem;
  }

  @media (max-width: 768px) {
    .tools {
      padding: 1.5rem 1rem 3rem;
    }

    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
