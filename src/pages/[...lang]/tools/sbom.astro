---
import Card from "@components/Card.astro";
import Header from "@components/Header.astro";
import SbomViewer from "@components/sbom/Viewer";
import ToolLayout from "@layouts/ToolLayout.astro";
import {
  getLanguage,
  getTranslationPaths,
  useTranslations,
} from "@locales/utils";

export function getStaticPaths() {
  return getTranslationPaths();
}

const lang = getLanguage(Astro.params.lang);
const t = useTranslations(lang);
---

<ToolLayout title={t.sbom.title} description={t.sbom.description}>
  <Header>{t.sbom.header}</Header>
  <Card class="tool">
    <SbomViewer lang={lang} client:only="react" />
  </Card>
</ToolLayout>

<style>
  .tool {
    max-width: var(--container);
    margin: 2rem auto;
  }

  @media (max-width: 1088px) {
    .tool {
      margin: 1.5rem 1rem;
    }
  }
</style>
