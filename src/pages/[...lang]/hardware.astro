---
import { Picture } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
import {
  getLanguage,
  getPath,
  getTranslationPaths,
  useTranslations,
} from "@locales/utils";

import hero from "@images/hardware/hero.webp";
import boardTop from "@images/hardware/board_top.webp";
import boardBottom from "@images/hardware/board_bottom.webp";
import espDetail from "@images/hardware/esp.webp";
import calloutVia from "@images/hardware/callout_via.webp";
import calloutEdge from "@images/hardware/callout_edge.webp";
import calloutLoop from "@images/hardware/callout_loop.webp";
import layers from "@images/hardware/process_layers.webp";
import schematic from "@images/hardware/process_schematic.webp";
import emulator from "@images/hardware/emulator.webp";
import slot from "@images/hardware/slot_current.webp";
import pdn from "@images/hardware/pdn_3v3.webp";
import emcMap from "@images/hardware/emc_map.webp";

export function getStaticPaths() {
  return getTranslationPaths();
}

const lang = getLanguage(Astro.params.lang);
const t = useTranslations(lang).hardware;
const contact = getPath(lang, "/contact");

// The near-field map comes from a long solver run: the page shows it when its image is there
const fdtd = Object.values(
  import.meta.glob<{ default: ImageMetadata }>(
    "../../images/hardware/fdtd_near.webp",
    { eager: true }
  )
)[0]?.default;

const formats: ("avif" | "webp")[] = ["avif", "webp"];

const order = ["review", "board", "firmware", "emc"] as const;
const callouts = [calloutVia, calloutEdge, calloutLoop];
---

<BaseLayout title={t.title} description={t.description} image={hero.src}>
  <section class="hero">
    <div class="container hero-text">
      <span class="eyebrow">{t.eyebrow}</span>
      <h1>{t.heroTitle}</h1>
      <p class="lead">{t.heroLead}</p>
      <div class="actions">
        <Button href={contact}>{t.heroPrimary}</Button>
        <a class="ghost" href="#case">{t.heroSecondary}</a>
      </div>
    </div>
    <figure class="hero-figure">
      <Picture
        src={hero}
        alt=""
        formats={formats}
        fallbackFormat="jpg"
        widths={[900, 1400, 2000, 2400]}
        sizes="(max-width: 900px) 100vw, 1440px"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>{t.heroCaption}</figcaption>
    </figure>
    <div class="container">
      <ul class="stats">
        {
          t.stats.map((stat) => (
            <li>
              <strong>{stat.value}</strong>
              <span>{stat.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="container intro">
    <span class="eyebrow">{t.servicesEyebrow}</span>
    <h2>{t.servicesTitle}</h2>
    <ol class="toc">
      {
        order.map((id, i) => (
          <li>
            <a href={`#${id}`}>
              <span class="num">{String(i + 1).padStart(2, "0")}</span>
              {t.items[id].label}
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  {
    order.map((id, i) => {
      const item = t.items[id];
      return (
        <section class={`feature ${i % 2 ? "alt" : ""}`} id={id}>
          <div class="container">
            <div class="feature-head">
              <span class="badge">{String(i + 1).padStart(2, "0")}</span>
              <div class="feature-text">
                <h2>{item.label}</h2>
                <p class="lead accent">{item.lead}</p>
                <p class="muted">{item.text}</p>
                <Button href={contact}>{t.heroPrimary}</Button>
              </div>
              <div class="details">
                <ul>
                  {item.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
                <p class="proof">
                  <span class="eyebrow">{useTranslations(lang).proofLabel}</span>
                  {item.proof}
                </p>
              </div>
            </div>

            {id === "review" && (
              <ul class="shots three">
                {callouts.map((img, k) => (
                  <li>
                    <Picture
                      src={img}
                      alt=""
                      formats={formats}
                      fallbackFormat="jpg"
                      widths={[360, 432]}
                      sizes="(max-width: 700px) 100vw, 330px"
                      loading="lazy"
                    />
                    <span>{t.items.review.callouts[k]}</span>
                  </li>
                ))}
              </ul>
            )}

            {id === "board" && (
              <div class="process">
                <figure class="wide">
                  <Picture
                    src={layers}
                    alt=""
                    formats={formats}
                    fallbackFormat="jpg"
                    widths={[800, 1400, 2200]}
                    sizes="(max-width: 1100px) 100vw, 1040px"
                    loading="lazy"
                  />
                  <figcaption>{item.steps[1]}</figcaption>
                </figure>
                <div class="pair">
                  <figure>
                    <Picture
                      src={schematic}
                      alt=""
                      formats={formats}
                      fallbackFormat="jpg"
                      widths={[600, 783]}
                      sizes="(max-width: 700px) 100vw, 510px"
                      loading="lazy"
                    />
                    <figcaption>{item.steps[0]}</figcaption>
                  </figure>
                  <figure>
                    <Picture
                      src={boardBottom}
                      alt=""
                      formats={formats}
                      fallbackFormat="jpg"
                      widths={[500, 900]}
                      sizes="(max-width: 700px) 100vw, 330px"
                      loading="lazy"
                    />
                    <figcaption>{item.steps[2]}</figcaption>
                  </figure>
                </div>
              </div>
            )}

            {id === "firmware" && (
              <figure class="wide">
                <Picture
                  src={emulator}
                  alt=""
                  formats={formats}
                  fallbackFormat="jpg"
                  widths={[800, 1200, 1500]}
                  sizes="(max-width: 1100px) 100vw, 1040px"
                  loading="lazy"
                />
                <figcaption>{t.items.firmware.caption}</figcaption>
              </figure>
            )}

            {id === "emc" && (
              <div class="fields">
                <figure class="big">
                  <Picture
                    src={slot}
                    alt=""
                    formats={formats}
                    fallbackFormat="jpg"
                    widths={[700, 1100, 1600]}
                    sizes="(max-width: 900px) 100vw, 640px"
                    loading="lazy"
                  />
                  <figcaption>
                    <strong>{t.items.emc.slotTitle}</strong>
                    {t.items.emc.slotCaption}
                  </figcaption>
                </figure>
                {fdtd && (
                  <figure class="big">
                    <Picture
                      src={fdtd}
                      alt=""
                      formats={formats}
                      fallbackFormat="jpg"
                      widths={[700, 1100, 1600]}
                      sizes="(max-width: 900px) 100vw, 640px"
                      loading="lazy"
                    />
                    <figcaption>
                      <strong>{t.items.emc.fdtdTitle}</strong>
                      {t.items.emc.fdtdCaption}
                    </figcaption>
                  </figure>
                )}
                <figure class="wide">
                  <Picture
                    src={pdn}
                    alt=""
                    formats={formats}
                    fallbackFormat="jpg"
                    widths={[700, 1100, 1400]}
                    sizes="(max-width: 1100px) 100vw, 1040px"
                    loading="lazy"
                  />
                  <figcaption>
                    <strong>{t.items.emc.pdnTitle}</strong>
                    {t.items.emc.pdnCaption}
                  </figcaption>
                </figure>
              </div>
            )}
          </div>
        </section>
      );
    })
  }

  <section class="container map">
    <div class="map-text">
      <span class="eyebrow">{t.mapEyebrow}</span>
      <h2>{t.mapTitle}</h2>
      <p class="muted">{t.mapText}</p>
      <ul class="legend">
        {t.mapLegend.map((l, i) => <li class={`l${i}`}>{l}</li>)}
      </ul>
    </div>
    <figure class="map-figure">
      <Picture
        src={emcMap}
        alt=""
        formats={formats}
        fallbackFormat="jpg"
        widths={[500, 800, 1100]}
        sizes="(max-width: 900px) 100vw, 420px"
        loading="lazy"
      />
    </figure>
  </section>

  <section class="band" id="case">
    <div class="container">
      <div class="case-head">
        <span class="eyebrow">{t.caseEyebrow}</span>
        <h2>{t.caseTitle}</h2>
        <p class="lead accent">{t.caseLead}</p>
        <p class="muted">{t.caseText}</p>
      </div>
      <ul class="stats compact">
        {
          t.caseFacts.map((f) => (
            <li>
              <strong>{f.value}</strong>
              <span>{f.label}</span>
            </li>
          ))
        }
      </ul>
      <div class="case-grid">
        <div class="case-boards">
          <figure>
            <Picture
              src={boardTop}
              alt=""
              formats={formats}
              fallbackFormat="jpg"
              widths={[400, 700, 900]}
              sizes="(max-width: 900px) 50vw, 250px"
              loading="lazy"
            />
            <figcaption>{t.caseImages[0]}</figcaption>
          </figure>
          <figure>
            <Picture
              src={boardBottom}
              alt=""
              formats={formats}
              fallbackFormat="jpg"
              widths={[400, 700, 900]}
              sizes="(max-width: 900px) 50vw, 250px"
              loading="lazy"
            />
            <figcaption>{t.caseImages[1]}</figcaption>
          </figure>
        </div>
        <div class="findings">
          <h3>{t.findingsTitle}</h3>
          <ul class="warn">{t.findings.map((f) => <li>{f}</li>)}</ul>
          <h3>{t.checkedTitle}</h3>
          <ul class="ok">{t.checked.map((f) => <li>{f}</li>)}</ul>
          <p class="muted note">{t.caseNote}</p>
        </div>
      </div>
      <figure class="detail">
        <Picture
          src={espDetail}
          alt=""
          formats={formats}
          fallbackFormat="jpg"
          widths={[600, 1000, 1400]}
          sizes="(max-width: 1100px) 100vw, 1040px"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <section class="container">
    <div class="section-heading">
      <span class="eyebrow">{t.processEyebrow}</span>
      <h2>{t.processTitle}</h2>
    </div>
    <ol class="plan">
      {
        t.process.map((step, i) => (
          <li>
            <span class="number">{String(i + 1).padStart(2, "0")}</span>
            <h3>{step.label}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container">
    <aside class="honesty">
      <h3>{t.honestyTitle}</h3>
      <p class="muted">{t.honesty}</p>
    </aside>
  </section>

  <section class="container">
    <div class="cta">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2>{t.ctaHeader}</h2>
      <p>{t.ctaText}</p>
      <Button href={contact}>{t.ctaButton}</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: var(--container);
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    box-sizing: border-box;
  }

  section {
    padding-top: 4.5rem;
    padding-bottom: 4.5rem;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin: 0 0 1.5rem;
  }

  h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    margin: 0 0 1rem;
  }

  h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  p {
    margin: 0 0 1rem;
  }

  .lead {
    font-size: 1.15rem;
  }

  .accent {
    color: var(--accent);
    font-weight: 500;
  }

  /* hero */
  .hero {
    position: relative;
    padding-top: 5rem;
    padding-bottom: 3rem;
    background:
      radial-gradient(
        ellipse 70% 45% at 50% 38%,
        rgba(255, 145, 0, 0.16),
        transparent 70%
      ),
      var(--bg);
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, #000, transparent);
    pointer-events: none;
  }

  .hero-text {
    position: relative;
    max-width: 860px;
    text-align: center;
  }

  .hero-text .lead {
    color: var(--muted);
    max-width: 720px;
    margin: 0 auto 2rem;
  }

  .actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .ghost {
    padding: 0.75em 1.5em;
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition:
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .ghost:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .hero-figure {
    position: relative;
    margin: 1rem auto 0;
    max-width: 1440px;
  }

  .hero-figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    animation: float 9s ease-in-out infinite;
  }

  .hero-figure figcaption {
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: -1rem;
    position: relative;
  }

  @keyframes float {
    50% {
      transform: translateY(-8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-figure :global(img) {
      animation: none;
    }
  }

  .stats {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: rgba(22, 24, 27, 0.8);
    position: relative;
  }

  .stats li {
    padding: 1.4rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .stats li + li {
    border-left: 1px solid var(--border);
  }

  .stats strong {
    font-size: 2.1rem;
    letter-spacing: -0.03em;
    color: var(--accent);
    line-height: 1;
    text-shadow: 0 0 24px rgba(255, 145, 0, 0.45);
  }

  .stats span {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .stats.compact {
    grid-template-columns: repeat(3, 1fr);
    margin-bottom: 2.5rem;
    background: var(--surface-2);
  }

  /* intro and table of contents */
  .intro {
    text-align: center;
    padding-top: 3rem;
    padding-bottom: 1rem;
  }

  .toc {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    text-align: left;
  }

  .toc a {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    box-sizing: border-box;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    font-weight: 600;
    transition:
      border-color 0.2s ease,
      transform 0.15s ease;
  }

  .toc a:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }

  .num {
    color: var(--accent);
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }

  /* feature sections */
  .feature {
    scroll-margin-top: 4rem;
  }

  .feature.alt {
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .feature-head {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .badge {
    position: absolute;
    top: -2.9rem;
    left: 0;
    font-size: 5rem;
    font-weight: 700;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 145, 0, 0.4);
    line-height: 1;
    pointer-events: none;
  }

  .feature-text {
    padding-top: 1.5rem;
    grid-column: 1;
  }

  .feature-text :global(.btn) {
    margin-top: 0.5rem;
  }

  .details {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.75rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-top: 1.5rem;
  }

  .feature.alt .details {
    background: var(--bg);
  }

  .details ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .details li {
    position: relative;
    padding-left: 1.75rem;
    line-height: 1.5;
  }

  .details li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }

  .proof {
    margin: 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
  }

  .proof .eyebrow {
    margin-bottom: 0.4rem;
  }

  /* pictures */
  figure {
    margin: 0;
  }

  figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow:
      0 0 0 1px rgba(255, 145, 0, 0.04),
      0 18px 50px rgba(0, 0, 0, 0.55);
  }

  figcaption {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  figcaption strong {
    display: block;
    color: var(--text);
    margin-bottom: 0.2rem;
  }

  .shots {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  .shots.three {
    grid-template-columns: repeat(3, 1fr);
  }

  .shots li {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .shots :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }

  .shots span {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .wide {
    margin-top: 3rem;
  }

  .process .pair {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 1.25rem;
    margin-top: 1.25rem;
    align-items: start;
  }

  .process .pair :global(img) {
    height: 100%;
    object-fit: cover;
    max-height: 520px;
  }

  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem 1.5rem;
    margin-top: 3rem;
  }

  .fields .big:first-child:nth-last-child(2) {
    grid-column: 1 / -1;
  }

  .fields .wide {
    grid-column: 1 / -1;
    margin-top: 0.5rem;
  }

  /* the whole-board map */
  .map {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 3rem;
    align-items: center;
  }

  .legend {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .legend li::before {
    content: "";
    display: inline-block;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    margin-right: 0.5rem;
    background: #ffb020;
    box-shadow: 0 0 10px currentColor;
  }

  .legend .l1::before {
    background: #4aa8ff;
  }

  .legend .l2::before {
    background: #ff9100;
    border-radius: 2px;
  }

  .legend .l3::before {
    background: #4aa8ff;
    border-radius: 2px;
  }

  /* case study */
  .band {
    background:
      radial-gradient(ellipse at 80% 0%, var(--accent-soft), transparent 55%),
      var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    scroll-margin-top: 4rem;
  }

  .case-head {
    max-width: 760px;
    margin-bottom: 2rem;
  }

  .case-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 2.5rem;
    align-items: start;
  }

  .case-boards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .findings h3 {
    margin: 0 0 0.75rem;
  }

  .findings ul {
    list-style: none;
    margin: 0 0 1.75rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .findings li {
    position: relative;
    padding-left: 1.75rem;
    line-height: 1.5;
  }

  .findings .warn li::before {
    content: "!";
    color: #ffb020;
  }

  .findings .ok li::before {
    content: "✓";
    color: #3ddc97;
  }

  .findings li::before {
    position: absolute;
    left: 0;
    font-weight: 700;
  }

  .note {
    font-size: 0.9rem;
    margin: 0;
  }

  .detail {
    margin-top: 3rem;
  }

  /* process, honesty, call to action */
  .section-heading {
    max-width: 720px;
    margin-bottom: 2.5rem;
  }

  .plan {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .plan li {
    padding-top: 1.25rem;
    border-top: 2px solid var(--border);
  }

  .plan li:first-child {
    border-top-color: var(--accent);
  }

  .number {
    display: block;
    color: var(--accent);
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
  }

  .plan p {
    margin: 0.5rem 0 0;
